# Regul8d Caffein8d / Neon + Next.js

# Neon Postgres connection string (pooled recommended for Vercel)
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Public site URL used for metadata, canonical links, sitemap, and robots.txt
NEXT_PUBLIC_SITE_URL=https://regul8dcaffein8d.com

# Collection admin (single owner). Required for /admin and write APIs.
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_SESSION_SECRET=choose-a-long-random-string

# Vercel Blob read/write token for watch photo uploads
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
